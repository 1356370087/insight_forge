OPENAI_API_KEY=
DASHSCOPE_API_KEY=
QUALITY_EVALUATION_ENABLED=false
QUALITY_EVALUATION_MODEL=openai:qwen3.7-plus
QUALITY_EVALUATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Observability (Langfuse tracing + Prometheus metrics)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Optional supplement for LangChain chains. Direct TraceRecorder instrumentation
# remains the primary source and avoids duplicate model observations by default.
LANGFUSE_LANGCHAIN_CALLBACK_ENABLED=false
PROMETHEUS_ENABLED=false
PROMETHEUS_METRICS_PATH=/metrics

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# File Mailbox async research coordination
TASK_STATE_BACKEND=file
MAX_PERSISTENT_TEAMMATES=5
MAILBOX_POLL_INTERVAL_MS=500
MAILBOX_LOCK_TIMEOUT_SECONDS=5
MAILBOX_CLAIM_LEASE_SECONDS=30
MAILBOX_MAX_DELIVERY_ATTEMPTS=5
MAILBOX_ACKED_RETENTION_SECONDS=86400
MAILBOX_COMPACTION_THRESHOLD=1000
LEADER_HEARTBEAT_SECONDS=5
LEADER_LEASE_SECONDS=15
