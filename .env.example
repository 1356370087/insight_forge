# 本文件仅提供本地开发与部署配置示例，请复制为 .env 后再填写真实值。
# 不要提交包含 API Key、访问令牌、Cookie 或其他凭据的实际 .env 文件。
# 布尔值统一使用 true 或 false；模型名称统一使用“提供商:模型名”格式。

# 日志格式：console（本地友好）或 json（生产采集）。
LOG_FORMAT=console

# 沙箱默认关闭。启用后必须同时开启异步研究，并部署 Controller/Gateway。
SANDBOX_ENABLED=false
SANDBOX_POLICY_PATH=config/sandbox-policy.toml
SANDBOX_CONTROLLER_SOCKET=/run/insightforge/sandbox-controller.sock
SANDBOX_GATEWAY_URL=http://sandbox-gateway:8081
# 至少 32 字节随机值的 Base64；API、Controller 与 Gateway 必须一致。
# SANDBOX_ROOT_SIGNING_KEY=
# 仅 development/test 的确定性 CI Provider；生产环境强制拒绝 true。
SANDBOX_GATEWAY_FAKE_PROVIDER=false
# Compose 同时启动三服务时允许依赖就绪的等待窗口；窗口结束仍 fail-closed。
SANDBOX_STARTUP_GRACE_SECONDS=30

# =============================================================================
# 一、模型服务凭据与兼容端点
# =============================================================================

# OpenAI API Key；仅在使用 OpenAI 官方模型或兼容接口时填写。
OPENAI_API_KEY=

# OpenAI 兼容接口地址；留空时使用 SDK 默认地址。
OPENAI_BASE_URL=

# 阿里云百炼 DashScope API Key；Qwen 系列模型通常使用此凭据。
DASHSCOPE_API_KEY=

# DeepSeek API Key；DeepSeek 主模型和辅助模型使用此凭据。
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容接口地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic API Key；仅在使用 Claude 系列模型或 Anthropic 原生搜索时填写。
ANTHROPIC_API_KEY=

# Google API Key；仅在使用 Gemini 系列模型时填写。
GOOGLE_API_KEY=

# =============================================================================
# 二、核心研究模型
# =============================================================================

# 对搜索结果、网页内容和长对话进行摘要的模型。
SUMMARIZATION_MODEL=openai:deepseek-v4-flash

# 执行 Subagent 推理、工具规划和研究循环的主模型。
RESEARCH_MODEL=openai:deepseek-v4-flash

# 将 Subagent 原始研究结果压缩为结构化交接内容的模型。
COMPRESSION_MODEL=openai:deepseek-v4-flash

# 汇总全部研究证据并生成最终报告的模型。
FINAL_REPORT_MODEL=openai:deepseek-v4-flash

# 摘要模型单次响应的最大输出 Token 数。
SUMMARIZATION_MODEL_MAX_TOKENS=8192

# 研究模型单次响应的最大输出 Token 数。
RESEARCH_MODEL_MAX_TOKENS=10000

# 压缩模型单次响应的最大输出 Token 数。
COMPRESSION_MODEL_MAX_TOKENS=10000

# 最终报告模型单次响应的最大输出 Token 数。
FINAL_REPORT_MODEL_MAX_TOKENS=10000

# =============================================================================
# 三、研究流程与 Agent 调度
# =============================================================================

# 搜索服务类型；可选值为 tavily、openai、anthropic、none。
SEARCH_API=tavily

# 是否允许系统在研究开始前向用户提出一次澄清问题。
ALLOW_CLARIFICATION=true

# 同一轮 Supervisor 最多并行运行的 Researcher 数量。
MAX_CONCURRENT_RESEARCH_UNITS=5

# Supervisor 最多执行的研究调度轮数。
MAX_RESEARCHER_ITERATIONS=6

# 单个 Researcher 最多执行的工具循环次数。
MAX_REACT_TOOL_CALLS=10

# 单次研究工具调用的超时时间，单位为秒。
RESEARCH_TOOL_CALL_TIMEOUT_SECONDS=300

# 按角色配置模型候选降级链，JSON 对象；键为角色名，值为按顺序尝试的模型列表。
# 可用角色：supervisor、researcher、summarization、message_summary、
# compression、final_report、quality_evaluation。
# 重试耗尽或熔断打开后按列表顺序切换候选；留空（默认）时禁用回退，
# 熔断仅提供"快速失败 + 冷却探针"的节流保护。
MODEL_FALLBACKS={"researcher":["anthropic:claude-sonnet-4-5"],"supervisor":["openai:gpt-4.1"]}

# 模型传输层错误（限流/超时/连接错误）在自研重试循环中的最大尝试次数。
MODEL_TRANSPORT_MAX_ATTEMPTS=3

# 单次模型调用的整体超时时间，单位为秒。
MODEL_CALL_TIMEOUT_SECONDS=180

# 是否启用进程内模型熔断器；关闭后保持原有重试与候选回退行为。
MODEL_CIRCUIT_BREAKER_ENABLED=true

# 失败窗口内触发熔断所需的重试耗尽级失败次数。
MODEL_CIRCUIT_FAILURE_THRESHOLD=5

# 统计模型失败与慢首包样本的滑动窗口，单位为秒。
MODEL_CIRCUIT_FAILURE_WINDOW_SECONDS=300

# 首次熔断后的基础冷却时间，单位为秒。
MODEL_CIRCUIT_OPEN_COOLDOWN_SECONDS=60

# 半开探针连续失败时指数退避的最大冷却时间，单位为秒。
MODEL_CIRCUIT_MAX_COOLDOWN_SECONDS=600

# enforced 模式下触发慢首包熔断的窗口占比阈值，取值范围为 0 到 1。
MODEL_CIRCUIT_SLOW_RATIO_THRESHOLD=0.5

# 参与慢首包占比判定所需的最小样本数。
MODEL_CIRCUIT_SLOW_MIN_SAMPLES=4

# 首包探测模式；off 关闭，shadow 仅测量，enforced 启用超时与熔断决策。
MODEL_FIRST_PACKET_PROBE=shadow

# enforced 模式等待流式首包的硬超时时间，单位为秒。
MODEL_FIRST_PACKET_TIMEOUT_SECONDS=15

# 将首包判为慢调用的延迟阈值，单位为秒。
MODEL_SLOW_FIRST_PACKET_THRESHOLD_SECONDS=8

# =============================================================================
# 四、搜索服务与结构化证据流水线
# =============================================================================

# Tavily API Key；SEARCH_API=tavily 时必须填写。
TAVILY_API_KEY=

# Firecrawl API Key；启用对应网页抓取能力时填写。
FIRECRAWL_API_KEY=

# Web 流水线模式；legacy 使用旧流程，shadow 仅旁路评估，enforced 强制执行结构化证据流程。
WEB_PIPELINE_MODE=enforced

# shadow 模式下进入旁路评估的请求比例，取值范围为 0 到 1。
WEB_PIPELINE_SHADOW_SAMPLE_RATE=0.1

# 搜索候选中实际进入抓取阶段的 Top-K 数量。
FETCH_TOP_K=5

# 来源权威度最低阈值，取值范围为 0 到 1。
WEB_MIN_SOURCE_AUTHORITY=0.65

# 搜索候选来源重排模型；未配置时代码默认使用 openai:gpt-4.1-mini。
WEB_RERANK_MODEL=openai:deepseek-v4-flash

# 网页内容证据抽取模型；未配置时代码默认使用 openai:gpt-4.1-mini。
WEB_EVIDENCE_MODEL=openai:deepseek-v4-flash

# 每次搜索允许进入重排阶段的最大候选来源数。
SEARCH_CANDIDATE_LIMIT=20

# 单个 Researcher 允许执行的最大网页抓取次数。
MAX_FETCHES_PER_RESEARCHER=12

# 单次完整研究运行允许执行的最大网页抓取次数。
MAX_FETCHES_PER_RUN=40

# 全局同时执行网页抓取的最大并发数。
FETCH_GLOBAL_CONCURRENCY=4

# 同一域名同时执行网页抓取的最大并发数。
FETCH_PER_HOST_CONCURRENCY=2

# 单个 HTML 文档允许读取的最大字节数，示例值为 2 MiB。
HTML_MAX_BYTES=2097152

# 单个 PDF 文档允许读取的最大字节数，示例值为 20 MiB。
PDF_MAX_BYTES=20971520

# 单个 PDF 文档允许处理的最大页数。
PDF_MAX_PAGES=100

# 是否遵守目标网站的 robots.txt 规则。
RESPECT_ROBOTS_TXT=true

# 普通 HTTP 抓取失败时是否允许使用浏览器渲染作为降级方案。
BROWSER_RENDER_FALLBACK_ENABLED=true

# =============================================================================
# 五、质量门禁与研究交接评估
# =============================================================================

# 是否启用研究证据、Subagent 交接和最终报告质量评估。
QUALITY_EVALUATION_ENABLED=false

# 质量评估模型；建议与研究主模型分离，避免同源偏差。
QUALITY_EVALUATION_MODEL=openai:qwen3.7-plus

# 质量评估模型的 OpenAI 兼容接口地址。
QUALITY_EVALUATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 质量评估模型专用 API Key；留空时按模型提供商规则查找对应凭据。
QUALITY_EVALUATION_API_KEY=

# 质量评估异常时是否放行研究流程；true 表示评估器故障不阻断研究。
QUALITY_EVALUATION_FAIL_OPEN=true

# 质量评估严格度；可选值为 permissive、balanced、strict。
QUALITY_EVALUATION_RIGOR=balanced

# 质量门禁要求的最少独立来源数量。
QUALITY_EVALUATION_MIN_SOURCES=2

# =============================================================================
# 六、离线评测与基准测试模型
# =============================================================================

# 离线评测模型；留空时复用 QUALITY_EVALUATION_MODEL。
EVALUATION_MODEL=

# 离线评测模型接口地址；留空时复用质量评估模型的接口地址。
EVALUATION_BASE_URL=

# 离线评测模型 API Key；留空时复用质量评估模型的凭据。
EVALUATION_API_KEY=

# 离线评测模型单次响应的最大输出 Token 数。
EVALUATION_MODEL_MAX_TOKENS=8192

# 单次离线评测允许输入的最大证据字符数。
EVALUATION_EVIDENCE_MAX_CHARS=120000

# 北京地域专属工作空间地址示例：
# https://你的工作空间标识.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# =============================================================================
# 七、认证、前端接入与部署
# =============================================================================

# 允许访问 FastAPI 的前端来源，多个地址使用英文逗号分隔。
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 是否允许从每次运行的 configurable 中读取模型 API Key；Open Agent Platform 生产部署可设为 true。
GET_API_KEYS_FROM_CONFIG=false

# =============================================================================
# 八、长期记忆
# =============================================================================

# 是否启用长期记忆功能。
ENABLE_MEMORY=false

# Mem0 存储提供方式；platform 表示托管平台，其他模式需与项目实现保持一致。
MEM0_PROVIDER=platform

# Mem0 API Key；启用托管长期记忆时填写。
MEM0_API_KEY=

# 长期记忆应用标识，用于隔离不同应用的数据。
MEMORY_APP_ID=open_deep_research

# Mem0 记忆项目标识；使用托管项目时填写。
MEM0_MEMORY_PROJECT_ID=

# 写入长期记忆时使用的 Agent 标识。
MEMORY_AGENT_ID=lead_researcher

# 是否启用高级记忆 schema-v2；默认关闭以保持兼容。
MEMORY_ADVANCED_ENABLED=false

# Mem0 Platform 项目级 decay 的期望状态；仅由显式 maintenance configure-decay 命令应用。
MEMORY_DECAY_ENABLED=true

# schema-v2 启用时是否继续召回不可变更的 legacy 记忆；默认关闭，避免旧偏好与新偏好并列注入。
MEMORY_LEGACY_RECALL_ENABLED=false

# 是否在每次 run 结束后异步调度完整维护；默认关闭，推荐使用 daily CLI/系统定时器。
MEMORY_RUN_END_MAINTENANCE_ENABLED=false

# 同一用户并发写记忆时的最长等待秒数；超时后记忆写入仍按 advisory fail-open 跳过。
MEMORY_MUTATION_LOCK_TIMEOUT_SECONDS=5

# 是否生成并保存研究反思记忆。
MEMORY_REFLECTION_ENABLED=true

# reflection/profile/conflict 提示词的最大输入字符预算。
MEMORY_MAINTENANCE_MAX_INPUT_CHARS=30000

# 是否维护用户或领域画像记忆。
MEMORY_PROFILE_ENABLED=true

# 是否启用软遗忘，降低旧记忆权重而不是直接删除。
MEMORY_SOFT_FORGETTING_ENABLED=true

# 是否保存通过验证的研究洞见。
MEMORY_VERIFIED_INSIGHTS_ENABLED=true

# 可选的 JSON 半衰期覆盖配置，单位为天；取消下一行注释后生效。
# MEMORY_HALF_LIFE_DAYS={"user_research_preference":180,"domain_profile":180,"project_memory":90,"verified_research_insight":30,"reflection":90}

# =============================================================================
# 九、可观测性与指标
# =============================================================================

# 是否启用独立于 Trace/Langfuse/Prometheus 的最小 Token 核算持久化。
TOKEN_USAGE_ACCOUNTING_ENABLED=true

# Provider 成功响应未返回 usage 时，是否启用输入/输出 Token 估算补位。
TOKEN_USAGE_ESTIMATION_ENABLED=true

# 可选的每百万 Token 美元价格表；未配置的模型费用显示“未配置”而不是 0。
# MODEL_COSTS_PER_MILLION={"openai:gpt-4.1":{"input":2.0,"output":8.0,"cached_input":0.5}}

# 是否启用 Langfuse Trace 上报。
LANGFUSE_ENABLED=false

# Langfuse 公钥。
LANGFUSE_PUBLIC_KEY=

# Langfuse 私钥；不得提交到版本库或暴露给浏览器。
LANGFUSE_SECRET_KEY=

# Langfuse 服务地址，可替换为自托管地址。
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Langfuse 环境名称，用于区分开发、测试和生产数据。
LANGFUSE_ENVIRONMENT=development

# 是否额外启用 LangChain Callback；默认关闭以避免与直接 TraceRecorder 产生重复模型记录。
LANGFUSE_LANGCHAIN_CALLBACK_ENABLED=false

# 是否启用 LangSmith Trace；启用后还需配置 LANGSMITH_API_KEY。
LANGSMITH_ENABLED=false

# LangSmith 接口密钥。
LANGSMITH_API_KEY=

# 是否启用 Prometheus 指标端点。
PROMETHEUS_ENABLED=false

# Prometheus 指标暴露路径。
PROMETHEUS_METRICS_PATH=/metrics

# =============================================================================
# 十、异步研究、检查点与文件邮箱
# =============================================================================

# 是否启用异步研究任务模式。
ENABLE_ASYNC_RESEARCH=false

# 运行数据保存目录，包含 manifest、公开事件和任务活动日志。
RUNS_DIR=.runs

# Advisory .runs quota used by Prometheus capacity alerts; 0 means unlimited.
RUNS_DIR_MAX_BYTES=0

# 终态运行目录的保留清扫周期（秒）；0 关闭自动清扫。
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# 终态运行目录保留天数；0 永久保留。
RUN_RETENTION_DAYS=30

# Trace SQLite 保留天数；未设置时跟随 RUN_RETENTION_DAYS。
# TRACE_RETENTION_DAYS=30

# 每个登录主体每分钟最多创建的 run 数；0 关闭。
API_RUN_CREATE_PER_MINUTE=10

# 每个登录主体在本进程内最多并发运行数；0 关闭。
MAX_CONCURRENT_RUNS_PER_USER=3

# 本进程允许的 SSE 并发连接总数；0 关闭。
MAX_CONCURRENT_SSE_CONNECTIONS=50

# API 请求体上限（字节），默认 2 MiB。
MAX_REQUEST_BODY_BYTES=2097152

# 终态 run 在进程内继续保留的秒数；完整事件始终从磁盘事件流回放。
INFLIGHT_RUN_MEMORY_RETENTION_SECONDS=600

# 进程内 RunRecord 数量软上限；超限时优先淘汰最早结束的终态 run。
MAX_INFLIGHT_RUNS_IN_MEMORY=100

# 每个进程内 run 保留的最近事件数；磁盘 public_events.jsonl 不受此限制。
INFLIGHT_EVENT_BUFFER_SIZE=200

# 优雅停机时将运行中任务落为 interrupted 并取消任务的总预算（秒）。
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# 启动时是否扫描非终态 manifest，并将租约已失效的孤儿 run 标记为 interrupted。
RUN_RECOVERY_SWEEP_ON_STARTUP=true

# 异步任务状态存储后端；当前推荐使用 file。
TASK_STATE_BACKEND=file

# 单个异步任务的最大运行时间，单位为秒。
TASK_TIMEOUT_SECONDS=900

# 单个运行允许同时处于执行中的最大异步任务数。
MAX_IN_FLIGHT_TASKS=20

# 是否为异步 Researcher 保存并恢复检查点。
TASK_CHECKPOINT_ENABLED=true

# 是否写入异步任务内部事件日志。
EVENT_LOG_ENABLED=true

# 可长期保持在线的 Teammate 最大数量。
MAX_PERSISTENT_TEAMMATES=5

# 文件邮箱轮询间隔，单位为毫秒。
MAILBOX_POLL_INTERVAL_MS=500

# 获取文件邮箱锁的最大等待时间，单位为秒。
MAILBOX_LOCK_TIMEOUT_SECONDS=5

# 邮箱消息认领租约时长，单位为秒。
MAILBOX_CLAIM_LEASE_SECONDS=30

# 单条邮箱消息允许的最大投递次数。
MAILBOX_MAX_DELIVERY_ATTEMPTS=5

# 已确认邮箱消息的保留时间，单位为秒。
MAILBOX_ACKED_RETENTION_SECONDS=86400

# 邮箱消息数量达到该阈值后触发压缩整理。
MAILBOX_COMPACTION_THRESHOLD=1000

# Leader 心跳发送间隔，单位为秒。
LEADER_HEARTBEAT_SECONDS=5

# Leader 租约有效期，单位为秒，通常应大于心跳间隔。
LEADER_LEASE_SECONDS=15

# ============================================================
# 自有身份与 RBAC 系统（IAM）配置
# 除显式本地开发旁路外，IAM_DATABASE_URL 为必填项。
# ============================================================

# 运行环境。production 下强制校验 JWT 密钥与 SMTP；development 下可自动生成临时 JWT 密钥。
APP_ENV=development

# IAM 数据库（asyncpg）。生产和常规本地开发均必须配置。
# IAM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/odr_iam

# 本地开发认证旁路：仅在 APP_ENV=development 生效，返回合成的 researcher/developer 身份。
LOCAL_DEV_AUTH_BYPASS=false

# FastAPI 前方可信代理的跳数。代码默认 0（只信 socket 对端地址）；
# 值为 1 对应“仅经过本项目 nginx”一跳。若直接暴露 2024 端口必须保持 0，
# 否则客户端可伪造 X-Forwarded-For 轮换限流身份。
IAM_TRUSTED_PROXY_COUNT=1

# JWT 签发方。
IAM_JWT_ISSUER=open-deep-research

# Access / Refresh 各自独立的 Ed25519 密钥（PEM）。生产环境必须显式提供。
# 可用 python -c "from security.rbac.keys import generate_signing_keypair as g; print(*g(), sep='---')"
# 生成。当前签名私钥 + kid；IAM_JWT_*_VERIFY_KEYS 为可选的 {kid: 公钥} JSON，用于平滑轮换。
IAM_JWT_ACCESS_SIGNING_KEY=
IAM_JWT_ACCESS_KID=
IAM_JWT_ACCESS_VERIFY_KEYS=
IAM_JWT_REFRESH_SIGNING_KEY=
IAM_JWT_REFRESH_KID=
IAM_JWT_REFRESH_VERIFY_KEYS=

# 一次性邮箱令牌和 Refresh Token 摘要使用的独立 HMAC Secret；生产环境必填。
IAM_TOKEN_DIGEST_SECRET=

# 令牌与会话有效期（秒）。
IAM_ACCESS_TOKEN_TTL=900
IAM_REFRESH_IDLE_TTL=2592000
IAM_SESSION_ABSOLUTE_TTL=7776000
IAM_REFRESH_REUSE_GRACE=5
IAM_SSE_REAUTH_INTERVAL=60

# 一次性邮箱令牌有效期（秒）。
IAM_EMAIL_VERIFY_TTL=86400
IAM_PASSWORD_RESET_TTL=1800

# 邮件后端：console（开发，打印链接）或 smtp（生产）。
IAM_MAIL_BACKEND=console
IAM_SMTP_HOST=
IAM_SMTP_PORT=587
IAM_SMTP_STARTTLS=true
IAM_SMTP_USER=
IAM_SMTP_PASSWORD=
IAM_MAIL_FROM=no-reply@example.com
IAM_PUBLIC_BASE_URL=http://localhost:3000

# 是否开放注册。production 下开放注册必须配置 SMTP。
IAM_OPEN_REGISTRATION=false

# 分布式限流：每个窗口内每个身份（IP/邮箱）允许的次数，窗口长度 IAM_RATE_LIMIT_WINDOW（秒）。
IAM_LOGIN_RATE_LIMIT=10
IAM_REGISTER_RATE_LIMIT=5
IAM_RESEND_RATE_LIMIT=3
IAM_RESET_RATE_LIMIT=5
IAM_RATE_LIMIT_WINDOW=600

# 引导首个管理员（可重复执行；已存在管理员时为空操作）。
IAM_BOOTSTRAP_ADMIN_EMAIL=
IAM_BOOTSTRAP_ADMIN_PASSWORD=
