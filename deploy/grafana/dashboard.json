{
  "annotations": {
    "list": []
  },
  "description": "Operational overview for the InsightForge research control plane.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum by (status) (rate(open_deep_research_runs_total[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A"}
      ],
      "title": "Run throughput by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(open_deep_research_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(open_deep_research_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B"}
      ],
      "title": "Run duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "tokens"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum by (direction) (rate(open_deep_research_llm_tokens_total[$__rate_interval]))", "legendFormat": "{{direction}}", "refId": "A"}
      ],
      "title": "LLM token rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(increase(open_deep_research_llm_estimated_cost_usd_total[$__range]))", "legendFormat": "estimated cost", "refId": "A"}
      ],
      "title": "Estimated LLM cost",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(rate(open_deep_research_llm_cache_requests_total{cache_status=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(open_deep_research_llm_cache_requests_total[$__rate_interval])), 0.000001)", "legendFormat": "hit rate", "refId": "A"}
      ],
      "title": "Prompt cache hit rate",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "open_deep_research_research_tasks_pending", "legendFormat": "pending", "refId": "A"},
        {"expr": "open_deep_research_research_tasks_active", "legendFormat": "active", "refId": "B"}
      ],
      "title": "Research task queue depth",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(open_deep_research_research_task_queue_wait_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "A"}
      ],
      "title": "Research queue wait",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(rate(open_deep_research_terminal_rate_limits_total[$__rate_interval]))", "legendFormat": "terminal 429", "refId": "A"},
        {"expr": "sum by (error_type) (rate(open_deep_research_retries_total[$__rate_interval]))", "legendFormat": "retry {{error_type}}", "refId": "B"},
        {"expr": "sum by (dimension) (rate(open_deep_research_api_rate_limited_total[$__rate_interval]))", "legendFormat": "API {{dimension}}", "refId": "C"}
      ],
      "title": "Rate limits and retries",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "open_deep_research_runs_dir_bytes", "legendFormat": "used", "refId": "A"},
        {"expr": "open_deep_research_runs_dir_quota_bytes", "legendFormat": "quota", "refId": "B"}
      ],
      "title": "Durable run storage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum by (component, operation) (rate(open_deep_research_observability_export_errors_total[$__rate_interval]))", "legendFormat": "{{component}} / {{operation}}", "refId": "A"}
      ],
      "title": "Observability export errors",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["insightforge", "operations", "research"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "InsightForge Operations",
  "uid": "insightforge-operations",
  "version": 1
}
